+  /// Delete a single asset under `facts/assets`.
+  ///
+  /// [fileNameOrRelativePath] accepts either the bare filename returned by
+  /// [saveAssetFromFile] or the dataRoot-relative path it also returns. The
+  /// resolved file must stay inside the user's assets directory — anything
+  /// escaping it (via `..`, symlinks or an absolute path elsewhere) is refused.
+  ///
+  /// Returns true only when a file was actually removed. Assets have no index
+  /// table, so deleting the file is the whole cleanup. References to it
+  /// (`fs://<filename>`) simply resolve to "not found" afterwards.
+  Future<bool> deleteAsset({
+    required String userId,
+    required String fileNameOrRelativePath,
+  }) async {
+    if (fileNameOrRelativePath.trim().isEmpty) return false;
+    try {
+      final assetsPath = path.canonicalize(getAssetsPath(userId));
+      final absPath = path.isAbsolute(fileNameOrRelativePath)
+          ? path.canonicalize(fileNameOrRelativePath)
+          : path.canonicalize(
+              path.join(assetsPath, path.basename(fileNameOrRelativePath)),
+            );
+      if (!path.isWithin(assetsPath, absPath) && absPath != assetsPath) {

+        return false;
+      }
+      final file = File(absPath);
+      if (!await file.exists()) return false;
+      await file.delete();
+      _logger.info('Deleted asset $absPath');
+      return true;
+    } catch (e) {
+      _logger.warning('Failed to delete asset $fileNameOrRelativePath: $e');
+      return false;
+    }
+  }

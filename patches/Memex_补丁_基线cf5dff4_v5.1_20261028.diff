index 0000000..b6d4c57
--- /dev/null
+++ b/lib/data/services/image_text_ocr_service.dart
@@ -0,0 +1,208 @@
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:google_mlkit_text_recognition/google_mlkit_text_recognition.dart';
+import 'package:image/image.dart' as img;
+import 'package:memex/data/services/asset_safety_service.dart';
+import 'package:memex/utils/logger.dart';
+
+final _logger = getLogger('ImageTextOcr');
+
+/// On-device OCR for chat image attachments.
+///
+/// Used only when the user turns on "discard original after OCR". The
+/// recognizer is the bundled Chinese ML Kit model
+/// (`com.google.mlkit:text-recognition-chinese`), so this never touches the
+/// network and never costs tokens.
+///
+/// Returns '' on any failure — callers must treat that as "no text" and keep
+/// the original image, never as "delete the image".
+class ImageTextOcrService {
+  ImageTextOcrService._();
+
+  static final ImageTextOcrService instance = ImageTextOcrService._();
+
+  /// A result shorter than this after trimming is noise (a single stray glyph,
+  /// a logo letter, a UI fragment), not content worth deleting a photo for.
+  static const int _minUsefulChars = 2;
+
+  /// Long edge above which the image is downsampled before OCR. Keeps a
+  /// 4000x3000 camera shot from costing several seconds.
+  static const int _maxLongEdge = 2000;
+
+  /// Recognize text in [imagePath]. Never throws.
+  ///
+  /// Returns '' on every failure path, so the caller keeps the photo.
+  Future<String> recognize(String imagePath) async {
+    TextRecognizer? recognizer;
+    String? tmpDirPath;
+    try {
+      final safety = await AssetSafetyService.instance.inspectFile(imagePath);
+      if (!safety.safeForOcr) {
+        _logger.info('OCR skipped for $imagePath: ${safety.reason}');
+        return '';
+      }
+
+      final w = safety.width;
+      final h = safety.height;
+      final longEdge = (w != null && h != null)
+          ? (w > h ? w : h)
+          : null;
+      final prepared = await _prepareInput(imagePath, longEdge);
+      if (prepared == null) return '';
+      tmpDirPath = prepared.tmpDirPath;
+
+      recognizer = TextRecognizer(script: TextRecognitionScript.chinese);
+      final recognized = await recognizer.processImage(prepared.input);
+      final text = _cleanBlocks(recognized.blocks);
+      _logger.info(
+        'OCR finished for $imagePath: ${recognized.blocks.length} blocks, '
+        '${text.length} chars',
+      );
+      return text;
+    } catch (e) {
+      // Always fall back to "no text" so the original image is kept.
+      _logger.warning('OCR failed for $imagePath: $e');
+      return '';
+    } finally {
+      try {
+        recognizer?.close();
+      } catch (_) {
+        // Closing a half-initialized recognizer can throw; nothing to do.
+      }
+      if (tmpDirPath != null) {
+        // ML Kit has already consumed the bytes by now.
+        await _deleteQuietly(tmpDirPath);
+      }
+    }
+  }
+
+  /// Whether [text] carries enough content to justify dropping the photo.
+  bool isUseful(String text) => _meaningfulCharCount(text) >= _minUsefulChars;
+
+  Future<({InputImage input, String? tmpDirPath})?> _prepareInput(
+    String imagePath,
+    int? longEdge,
+  ) async {
+    if (longEdge == null || longEdge <= _maxLongEdge) {
+      return (input: InputImage.fromFilePath(imagePath), tmpDirPath: null);
+    }
+    // Too large: OCR a downsampled copy in a temp dir. The original stays
+    // untouched whether or not we end up keeping it.
+    String? tmpDirPath;
+    try {
+      final tmpDir = await Directory.systemTemp.createTemp('memex_ocr_');
+      tmpDirPath = tmpDir.path;
+      final tmpPath = '${tmpDir.path}/ocr_input.jpg';
+      final wrote = await compute(_writeDownsampledJpeg, <String, dynamic>{
+        'path': imagePath,
+        'target': _maxLongEdge,
+        'out': tmpPath,
+      });
+      if (!wrote) {
+        await _deleteQuietly(tmpDirPath);
+        return (input: InputImage.fromFilePath(imagePath), tmpDirPath: null);
+      }
+      return (input: InputImage.fromFilePath(tmpPath), tmpDirPath: tmpDirPath);
+    } catch (e) {
+      _logger.warning('Downsample for OCR failed, using original: $e');
+      if (tmpDirPath != null) await _deleteQuietly(tmpDirPath);
+      return (input: InputImage.fromFilePath(imagePath), tmpDirPath: null);
+    }
+  }
+
+  Future<void> _deleteQuietly(String path) async {
+    try {
+      await Directory(path).delete(recursive: true);
+    } catch (_) {}
+  }
+
+  /// Join blocks with a blank line, keeping intra-block line breaks, and stitch
+  /// CJK lines that the recognizer split mid-sentence.
+  String _cleanBlocks(List<TextBlock> blocks) {
+    final buffer = StringBuffer();
+    for (final block in blocks) {
+      final blockText = _joinLines(block.lines.map((l) => l.text).toList());
+      if (blockText.isEmpty) continue;
+      if (buffer.isNotEmpty) buffer.write('\n\n');
+      buffer.write(blockText);
+    }
+    return buffer.toString().trim();
+  }
+
+  String _joinLines(List<String> lines) {
+    final out = <String>[];
+    for (final raw in lines) {
+      final line = _normalizeLine(raw);
+      if (line.isEmpty) continue;
+      if (out.isNotEmpty && _shouldStitch(out.last, line)) {
+        out.last = '${out.last}${line.trimLeft()}';
+      } else {
+        out.add(line);
+      }
+    }
+    return out.join('\n');
+  }
+
+  /// Normalize whitespace only — the text itself is passed through untouched.
+  String _normalizeLine(String raw) {
+    if (raw.trim().isEmpty) return '';
+    return raw.trimRight().trimLeft();
+  }
+
+  /// CJK text wraps without spaces; a recognizer line break in the middle of a
+  /// sentence is an artifact, not structure. Stitch when the previous line does
+  /// not end a sentence and the next one does not start a list/number/heading.
+  bool _shouldStitch(String prev, String next) {
+    final trimmedPrev = prev.trimRight();
+    if (trimmedPrev.isEmpty) return false;
+    final last = trimmedPrev.codeUnitAt(trimmedPrev.length - 1);
+    const sentenceEnd = '。！？；：.!?;:，,、）」』”"\')】]}';
+    if (sentenceEnd.runes.contains(last)) return false;
+    final trimmedNext = next.trimLeft();
+    if (trimmedNext.isEmpty) return false;
+    if (RegExp(r'^[-*•·#]').hasMatch(trimmedNext)) return false;
+    if (RegExp(r'^\d+[.、)）]').hasMatch(trimmedNext)) return false;
+    final first = trimmedNext.codeUnitAt(0);
+    final isCjk = (first >= 0x4E00 && first <= 0x9FFF) ||
+        (first >= 0x3400 && first <= 0x4DBF) ||
+        (first >= 0x3000 && first <= 0x303F) ||
+        (first >= 0xFF00 && first <= 0xFFEF);
+    return isCjk;
+  }
+
+  int _meaningfulCharCount(String text) {
+    var count = 0;
+    for (final rune in text.runes) {
+      if (rune <= 0x20) continue;
+      count += 1;
+    }
+    return count;
+  }
+}
+
+/// Runs on an isolate: decode, clamp the long edge to `target`, re-encode JPEG.
+/// Returns true when [out] was written.
+bool _writeDownsampledJpeg(Map<String, dynamic> args) {
+  try {
+    final input = File(args['path'] as String).readAsBytesSync();
+    final decoded = img.decodeImage(input);
+    if (decoded == null) return false;
+    final target = args['target'] as int;
+    final longEdge =
+        decoded.width > decoded.height ? decoded.width : decoded.height;
+    final resized = longEdge <= target
+        ? decoded
+        : img.copyResize(
+            decoded,
+            width: decoded.width >= decoded.height ? target : null,
+            height: decoded.height > decoded.width ? target : null,
+            interpolation: img.Interpolation.average,
+          );
+    final bytes = img.encodeJpg(resized, quality: 90);
+    File(args['out'] as String).writeAsBytesSync(bytes);
+    return true;
+  } catch (_) {
+    return false;
+  }
+}
